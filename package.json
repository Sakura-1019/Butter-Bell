{
  "name": "butter-bell",
  "productName": "Butter Bell",
  "version": "0.1.0",
  "description": "Windows 本地游戏库管理器",
  "license": "MIT",
  "repository": "github:Sakura-1019/butter-bell",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit && electron-vite build && electron-builder --win",
    "postinstall": "install-electron",
    "test": "vitest run",
    "smoke:dlsite": "vitest run --mode smoke --silent=false src/core/dlsite.smoke.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "better-sqlite3": "^13.0.3",
    "i18next": "^26.7.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.11"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "better-sqlite3": false,
    "electron-winstaller": false
  }
}
